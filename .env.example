# App
NODE_ENV=development
PORT=3000
API_PREFIX=api

# CORS
CORS_ORIGIN=http://localhost:3001

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/horizon_pm

# JWT
JWT_ACCESS_SECRET=change-me-to-strong-random-string-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-different-strong-string-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Seed users (initial setup)
SEED_MANAGER_EMAIL=manager@horizonpm.com
SEED_MANAGER_PASSWORD=ChangeMe123!
SEED_SECRETARY_EMAIL=secretary@horizonpm.com
SEED_SECRETARY_PASSWORD=ChangeMe123!

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Logging
LOG_LEVEL=info
