generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MANAGER
  SECRETARY
}

enum BuildingType {
  RESIDENTIAL
  COMMERCIAL
  MIXED_USE
}

enum ConstructionStatus {
  COMPLETE
  UNDER_CONSTRUCTION
}

enum UnitType {
  APARTMENT
  STUDIO
  SHOP
  OFFICE
  ROOF_UNIT
  WAREHOUSE
}

enum PropertyStatus {
  OCCUPIED
  VACANT
  UNDER_MAINTENANCE
  RESERVED
}

enum TenantType {
  INDIVIDUAL
  COMPANY
}

enum TenantStatus {
  ACTIVE
  FORMER
}

enum DocumentType {
  EMIRATES_ID
  PASSPORT
  TRADE_LICENSE
  POWER_OF_ATTORNEY
  OTHER
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique
  passwordHash     String    @map("password_hash")
  fullName         String    @map("full_name")
  role             UserRole
  isActive         Boolean   @default(true) @map("is_active")
  lastLoginAt      DateTime? @map("last_login_at")
  refreshTokenHash String?   @map("refresh_token_hash")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  createdBuildings  Building[] @relation("BuildingCreatedBy")
  updatedBuildings  Building[] @relation("BuildingUpdatedBy")
  createdProperties Property[] @relation("PropertyCreatedBy")
  updatedProperties Property[] @relation("PropertyUpdatedBy")

  createdTenants    Tenant[]          @relation("TenantCreatedBy")
  updatedTenants    Tenant[]          @relation("TenantUpdatedBy")
  uploadedDocuments TenantDocument[]  @relation("DocumentUploadedBy")

  @@index([email])
  @@map("users")
}

model Building {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String
  code               String             @unique
  address            String
  city               String
  buildingType       BuildingType       @map("building_type")
  totalFloors        Int                @map("total_floors")
  yearBuilt          Int?               @map("year_built")
  totalUnits         Int?               @map("total_units")
  constructionStatus ConstructionStatus @default(COMPLETE) @map("construction_status")
  notes              String?            @db.Text
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")

  createdById String  @map("created_by") @db.Uuid
  updatedById String? @map("updated_by") @db.Uuid

  createdBy User  @relation("BuildingCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("BuildingUpdatedBy", fields: [updatedById], references: [id])

  properties Property[]

  @@index([code])
  @@index([name])
  @@index([deletedAt])
  @@map("buildings")
}

model Property {
  id          String         @id @default(uuid()) @db.Uuid
  unitNumber  String         @map("unit_number")
  buildingId  String         @map("building_id") @db.Uuid
  floor       Int
  unitType    UnitType       @map("unit_type")
  bedrooms    Int?
  bathrooms   Int?
  sizeSqm     Decimal?       @map("size_sqm") @db.Decimal(10, 2)
  monthlyRent Decimal        @map("monthly_rent") @db.Decimal(12, 2)
  status      PropertyStatus @default(VACANT)
  notes       String?        @db.Text
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  deletedAt   DateTime?      @map("deleted_at")

  createdById String  @map("created_by") @db.Uuid
  updatedById String? @map("updated_by") @db.Uuid

  building  Building @relation(fields: [buildingId], references: [id])
  createdBy User     @relation("PropertyCreatedBy", fields: [createdById], references: [id])
  updatedBy User?    @relation("PropertyUpdatedBy", fields: [updatedById], references: [id])

  @@unique([buildingId, unitNumber])
  @@index([buildingId])
  @@index([unitNumber])
  @@index([status])
  @@index([deletedAt])
  @@map("properties")
}

model Tenant {
  id                          String        @id @default(uuid()) @db.Uuid
  tenantType                  TenantType    @map("tenant_type")

  // Dual-language name — holds person name OR company name depending on tenantType
  nameEn                      String        @map("name_en")
  nameAr                      String?       @map("name_ar")

  // Contact (both types)
  phone                       String
  alternatePhone              String?       @map("alternate_phone")
  email                       String?

  // INDIVIDUAL-only
  nationality                 String?
  emiratesIdNumber            String?       @map("emirates_id_number")
  emiratesIdExpiry            DateTime?     @map("emirates_id_expiry") @db.Date
  passportNumber              String?       @map("passport_number")
  passportExpiry              DateTime?     @map("passport_expiry") @db.Date

  // COMPANY-only
  tradeLicenseNumber          String?       @map("trade_license_number")
  tradeLicenseExpiry          DateTime?     @map("trade_license_expiry") @db.Date
  authorizedPersonNameEn      String?       @map("authorized_person_name_en")
  authorizedPersonNameAr      String?       @map("authorized_person_name_ar")
  authorizedPersonOccupation  String?       @map("authorized_person_occupation")
  authorizedPersonPhone       String?       @map("authorized_person_phone")

  status                      TenantStatus  @default(ACTIVE)
  notes                       String?       @db.Text

  createdAt                   DateTime      @default(now()) @map("created_at")
  updatedAt                   DateTime      @updatedAt @map("updated_at")
  deletedAt                   DateTime?     @map("deleted_at")
  createdById                 String        @map("created_by") @db.Uuid
  updatedById                 String?       @map("updated_by") @db.Uuid

  documents                   TenantDocument[]
  createdBy                   User          @relation("TenantCreatedBy", fields: [createdById], references: [id])
  updatedBy                   User?         @relation("TenantUpdatedBy", fields: [updatedById], references: [id])

  @@map("tenants")
  @@index([nameEn])
  @@index([nameAr])
  @@index([tenantType])
  @@index([status])
  @@index([deletedAt])
}

model TenantDocument {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  documentType  DocumentType  @map("document_type")
  fileName      String        @map("file_name")
  fileKey       String        @map("file_key")
  fileSize      Int           @map("file_size")
  mimeType      String        @map("mime_type")
  uploadedAt    DateTime      @default(now()) @map("uploaded_at")
  uploadedById  String        @map("uploaded_by") @db.Uuid
  deletedAt     DateTime?     @map("deleted_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  uploadedBy    User          @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])

  @@map("tenant_documents")
  @@index([tenantId])
  @@index([documentType])
  @@index([deletedAt])
}
